# Encontre estes valores em Cloudflare Dashboard > R2 > Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=holdotfiles

# Opcional: separa backups por máquina. O hostname é usado quando omitido.
# R2_PREFIX=meu-computador

# Opcional: use um endpoint explícito para buckets com jurisdição específica.
# R2_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com

# Opcional: caminho alternativo para a lista de arquivos.
# HOLDOTFILES_CONFIG=~/.hdtconfig
